# ------------------------------------------------------------------------------
# Production Environment Configuration (Docker Compose + Caddy)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=5001

# PostgreSQL Settings
POSTGRES_USER="qrpatterns"
POSTGRES_PASSWORD="generate_a_strong_db_password"
POSTGRES_DB="qrpatterns"

# Security & Secret Keys (Generate with: openssl rand -hex 32)
JWT_SECRET="<generate-with-openssl-rand-hex-32>"
ENCRYPTION_KEY="<generate-with-openssl-rand-hex-32>"

# Domain URL for QR shortlinks, Caddy SSL & CORS (no trailing slash)
CLIENT_URL="https://qrpatterns.site"
DOMAIN="qrpatterns.site"

# Disable demo account auto-seeding in production
SEED_DEMO="false"

# Optional Cloudinary Storage (leave blank to use persistent Docker volume storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
